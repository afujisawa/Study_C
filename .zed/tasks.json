[
  {
    "label": "C: Build and run current file",
    "command": "mkdir -p tmp && gcc -std=c11 -Wall -Wextra -Wpedantic -g \"$ZED_FILE\" -o tmp/program && ./tmp/program",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
